#!/bin/sh

dir="$(dirname "$(dirname "$(dirname "$(realpath "$0")")")")/config/tmux"
mkdir -p "$HOME/.config/tmux"
echo "$HOME/.config/tmux/tmux.conf -> $dir/tmux.conf"
ln -sfn "$dir/tmux.conf" "$HOME/.config/tmux/tmux.conf"

# tpm + plugins live outside the repo
tpm="$HOME/.config/tmux/plugins/tpm"
[ -d "$tpm" ] || git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm"
"$tpm/bin/install_plugins"
